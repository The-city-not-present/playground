def register_ip(subparsers) -> None:
    p = subparsers.add_parser("ip", help="Inspect interfaces/neighbours/routes and toggle links.")
    sub = p.add_subparsers(dest="action", required=True, metavar="ACTION")

    for name, aliases, obj, extra in (
        ("addr", ["address"], "addr", ("brief", "stats")),
        ("link", ["links"], "link", ("brief", "stats")),
        ("neigh", ["neighbour"], "neigh", ()),
        ("route", ["routes"], "route", ()),
    ):
        q = sub.add_parser(name, aliases=aliases, help=f"Show {obj} information (read-only).")
        q.add_argument("--dev", help="Interface to filter by.")
        if "brief" in extra:
            q.add_argument("--brief", action="store_true", help="Brief output.")
        if "stats" in extra:
            q.add_argument("--stats", action="store_true", help="Include statistics (-s).")
        q.set_defaults(func=ip_cmd_show, obj=obj)

    q = sub.add_parser("link-set", help="Bring an interface up or down (privileged).")
    q.add_argument("--device", required=True, help="Interface name.")
    q.add_argument("state", choices=["up", "down"], help="Desired link state.")
    q.set_defaults(func=ip_cmd_link_set)

    q = sub.add_parser("addr-add", help="Assign an IPv4 address to an interface (privileged).")
    q.add_argument("--device", required=True, help="Interface name.")
    q.add_argument("--address", required=True, metavar="IP/PREFIX", help="IPv4 in CIDR notation, e.g. 192.168.31.100/24.")
    q.set_defaults(func=ip_cmd_addr_add)

    q = sub.add_parser("addr-flush", help="Remove all addresses from an interface (privileged).")
    q.add_argument("--device", required=True, help="Interface name.")
    q.set_defaults(func=ip_cmd_addr_flush)

    q = sub.add_parser("neigh-add", help="Add a neighbour (ARP) entry (privileged).")
    q.add_argument("--device", required=True, help="Interface name.")
    q.add_argument("--address", required=True, metavar="IP", help="Neighbour IPv4 address.")
    q.add_argument("--lladdr", required=True, metavar="MAC", help="Link-layer (MAC) address, e.g. aa:bb:cc:dd:ee:ff.")
    q.add_argument("--nud", default="permanent", choices=["permanent", "noarp", "stale", "reachable"], help="Neighbour state (default: permanent).")
    q.set_defaults(func=ip_cmd_neigh_add)

    q = sub.add_parser("neigh-replace", help="Replace a neighbour (ARP) entry (privileged).")
    q.add_argument("--device", required=True, help="Interface name.")
    q.add_argument("--address", required=True, metavar="IP", help="Neighbour IPv4 address.")
    q.add_argument("--lladdr", required=True, metavar="MAC", help="Link-layer (MAC) address, e.g. aa:bb:cc:dd:ee:ff.")
    q.add_argument("--nud", default="permanent", choices=["permanent", "noarp", "stale", "reachable"], help="Neighbour state (default: permanent).")
    q.set_defaults(func=ip_cmd_neigh_replace)

    q = sub.add_parser("neigh-del", help="Delete a neighbour (ARP) entry (privileged).")
    q.add_argument("--device", required=True, help="Interface name.")
    q.add_argument("--address", required=True, metavar="IP", help="Neighbour IPv4 address.")
    q.set_defaults(func=ip_cmd_neigh_del)


