@privileged
def cmd_reset(args: argparse.Namespace) -> int:
    """Stop every long-running service a previous agent-proxy run may have left behind."""
    stop_process("TFTP server", ["-f", TFTP_PGREP_PATTERN])
    stop_process("dnsmasq", ["-x", "dnsmasq"])
    stop_process("tcpdump", ["-x", "tcpdump"])
    print("OK: reset complete.")
    return 0


def cmd_sudoers(args: argparse.Namespace) -> int:
    user = args.user or current_user()
    script = proxy_path()
    print(
        textwrap.dedent(
            f"""\
            # agent-proxy for automation agents - generated by {PROG}.
            # Grants '{user}' passwordless sudo access to *this proxy only*
            # (the script is root-owned and validates every operation), never to
            # the underlying tools directly. No other root operations are permitted.
            #
            # Install with:
            #   sudo sh -c '{PROG} sudoers --user {user} > /etc/sudoers.d/{PROG} && chmod 0440 /etc/sudoers.d/{PROG} && visudo -c -f /etc/sudoers.d/{PROG}'
            #
            {user} ALL=(root) NOPASSWD: {script} *
            """
        )
    )
    return 0


def cmd_doctor(args: argparse.Namespace) -> int:
    ok = True
    script = proxy_path()
    print(f"{PROG} version: {__version__}")
    print(f"proxy:  {script}")
    try:
        st = os.stat(script)
        if st.st_uid != 0:
            print("  WARN: proxy is not root-owned; a non-root owner could edit it and abuse the sudo rule.")
            ok = False
        if st.st_mode & 0o022:
            print("  WARN: proxy is group/other-writable; the agent user could edit it.")
            ok = False
    except OSError as exc:
        print(f"  WARN: cannot stat proxy: {exc}")
        ok = False

    print(f"user:   {current_user()}")

    for name, path in (
        ("nmcli", nmcli_path()),
        ("ip", ip_path()),
        ("dnsmasq", dnsmasq_path()),
        ("tcpdump", tcpdump_path()),
        ("pkill", pkill_path()),
        ("python3", python_path()),
    ):
        on_path = "on PATH" if shutil.which(name) else "fallback"
        print(f"{name}: {path} ({on_path})")
        if not os.path.exists(path):
            print(f"  WARN: {name} not found.")
            ok = False
    print(f"tftp:   {TFTP_SCRIPT}")
    if not os.path.isfile(TFTP_SCRIPT):
        print("  WARN: tftpserver.py not installed; re-run the installer.")
        ok = False

    listing = ""
    returncode = None
    try:
        proc = subprocess.run([sudo_path(), "-n", "-l"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        listing = (proc.stdout or "") + (proc.stderr or "")
        returncode = proc.returncode
    except OSError as exc:
        print(f"  WARN: could not run 'sudo -n -l': {exc}")
        ok = False

    if returncode == 0:
        if script in listing:
            print("  OK: the sudoers rule for this proxy appears to be present.")
        elif "(ALL" in listing or "ALL : ALL" in listing or "(root) ALL" in listing:
            print("  NOTE: user already has broad sudo privileges; the narrow proxy rule is not required.")
        else:
            print(f"  WARN: no sudoers rule for {script} found. Run '{PROG} sudoers' and install it.")
            ok = False
    else:
        print("  WARN: 'sudo -n -l' failed - the user may have no sudo privileges at all.")
        ok = False

    print("doctor result:", "OK" if ok else "ISSUES FOUND")
    return 0 if ok else 1

# ===========================================================================
# Argument parsing
# ===========================================================================

def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=PROG,
        description="Narrow, auditable wrapper around privileged network tools for unprivileged agents.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Examples:\n"
            f"  {PROG} nmcli list\n"
            f"  {PROG} nmcli set-static --device eth0 --address 192.168.1.10/24\n"
            f"  {PROG} ip addr\n"
            f"  {PROG} ip neigh\n"
            f"  {PROG} ip link-set --device eth0 up\n"
            f"  {PROG} ip addr-add --device eth0 --address 192.168.31.100/24\n"
            f"  {PROG} ip neigh-add --device eth0 --address 192.168.31.1 --lladdr 82:73:78:2e:b6:69\n"
            f"  {PROG} dnsmasq start --interface eth0 --range 192.168.1.10,192.168.1.20,12h --boot openwrt.bin\n"
            f"  {PROG} dnsmasq stop\n"
            f"  {PROG} tcpdump capture --interface eth0 --expression 'port 67 or port 69' --count 50\n"
            f"  {PROG} tcpdump stop\n"
            f"  {PROG} tftp serve --directory ~/firmware\n"
            f"  {PROG} reset        # stop tftp/dnsmasq/tcpdump left from a prior run\n"
            f"  {PROG} sudoers      # print the sudoers rule to install\n"
            f"  {PROG} doctor       # verify the setup\n"
        ),
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {__version__}")
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Print the privileged commands that would be run, without executing them.",
    )
    parser.add_argument(
        "--traceback",
        action="store_true",
        help="Also print the full Python traceback for expected (handled) failures.",
    )

    sub = parser.add_subparsers(dest="tool", required=True, metavar="TOOL")

    p = sub.add_parser("sudoers", help="Print the sudoers rule needed for the current user.")
    p.add_argument("--user", default=None, help="User to grant privileges to (default: current user).")
    p.set_defaults(func=cmd_sudoers)

    p = sub.add_parser("doctor", help="Check the environment and sudoers setup.")
    p.set_defaults(func=cmd_doctor)

    p = sub.add_parser("reset", help="Stop all agent-proxy-started services (tftp/dnsmasq/tcpdump).")
    p.set_defaults(func=cmd_reset)

    register_nmcli(sub)
    register_ip(sub)
    register_dnsmasq(sub)
    register_tcpdump(sub)
    register_tftp(sub)

    return parser


def main(argv: Optional[Sequence[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    global DRY_RUN
    DRY_RUN = args.dry_run

    try:
        func = args.func
        if getattr(func, "requires_root", False) and not DRY_RUN and os.geteuid() != 0:
            return _reexec_as_root()
        return int(func(args))
    except NetworkHelperError as exc:
        print(exc, file=sys.stderr)
        if args.traceback:
            traceback.print_exc()
        return 1
    except KeyboardInterrupt:
        print("\nERROR: interrupted by user.", file=sys.stderr)
        return 130
    except Exception as exc:  # noqa: BLE001 - report *everything* loudly
        print(f"UNEXPECTED ERROR: {exc}", file=sys.stderr)
        traceback.print_exc()
        return 2


if __name__ == "__main__":
    sys.exit(main())
