@privileged
def dnsmasq_cmd_start(args: argparse.Namespace) -> int:
    iface = validate_iface(args.interface)
    lo, hi, lease = validate_dhcp_range(args.range)

    argv = [
        dnsmasq_path(),
        f"--interface={iface}",
        "--bind-interfaces",
        f"--dhcp-range={lo},{hi},{lease}",
    ]
    if args.authoritative:
        argv.append("--dhcp-authoritative")
    if args.no_dns:
        argv.append("--port=0")
    if args.gateway:
        argv.append(f"--dhcp-option=3,{validate_ip(args.gateway, 'gateway')}")
    dns = validate_dns(args.dns or [])
    if dns:
        argv.append("--dhcp-option=6," + ",".join(dns))
    if args.boot:
        argv.append(f"--dhcp-boot={validate_bootfile(args.boot)}")
    if args.tftp_root:
        argv.append("--enable-tftp")
        argv.append(f"--tftp-root={validate_serve_directory(args.tftp_root)}")
    if args.log_queries:
        argv.append("--log-queries")
    if args.no_daemon:
        argv.append("--no-daemon")

    run_privileged(argv, stream=True)
    print(f"OK: started dnsmasq on {iface!r} (range {lo}-{hi}, lease {lease}).")
    return 0


@privileged
def dnsmasq_cmd_stop(args: argparse.Namespace) -> int:
    stop_process("dnsmasq", ["-x", "dnsmasq"])
    return 0


def register_dnsmasq(subparsers) -> None:
    p = subparsers.add_parser("dnsmasq", help="Run a scoped DHCP (and optional TFTP/DNS) server.")
    sub = p.add_subparsers(dest="action", required=True, metavar="ACTION")

    q = sub.add_parser("start", help="Start dnsmasq (privileged; daemonizes unless --no-daemon).")
    q.add_argument("--interface", required=True, help="Interface to serve DHCP on.")
    q.add_argument("--range", required=True, metavar="LO,HI[,LEASE]", help="DHCP range, e.g. 192.168.1.10,192.168.1.20,12h.")
    q.add_argument("--gateway", metavar="IP", help="Advertise this gateway (option 3).")
    q.add_argument("--dns", action="append", default=[], metavar="IP", help="Advertise these DNS servers (option 6; repeatable or comma-separated).")
    q.add_argument("--boot", metavar="FILE", help="Advertise this bootfile (dhcp-boot) for TFTP recovery.")
    q.add_argument("--tftp-root", metavar="DIR", help="Also serve TFTP from this directory (enables dnsmasq's built-in TFTP).")
    q.add_argument("--no-daemon", action="store_true", help="Stay in the foreground (do not daemonize).")
    q.add_argument("--log-queries", action="store_true", help="Log DHCP/DNS queries.")
    q.add_argument("--authoritative", action="store_true", help="Answer DHCP authoritatively (helps U-Boot recovery).")
    q.add_argument("--no-dns", action="store_true", help="Disable the DNS server (port=0); serve DHCP/TFTP only.")
    q.set_defaults(func=dnsmasq_cmd_start)

    q = sub.add_parser("stop", help="Stop dnsmasq (privileged).")
    q.set_defaults(func=dnsmasq_cmd_stop)

