@privileged
def tcpdump_cmd_capture(args: argparse.Namespace) -> int:
    iface = args.interface
    if iface != "any":
        iface = validate_iface(iface)

    argv = [tcpdump_path()]
    if args.no_resolve:
        argv.append("-n")
    if args.link_header:
        argv.append("-e")
    v = args.verbose or 0
    if v:
        argv.append("-" + "v" * min(v, 3))
    if args.snapshot_length:
        argv += ["-s", str(validate_snaplen(args.snapshot_length))]
    if args.count:
        argv += ["-c", str(validate_count(args.count))]
    if args.write:
        argv += ["-w", validate_writable_path(args.write)]
    argv += ["-i", iface]
    if args.expression:
        argv.append(validate_expression(args.expression))

    run_privileged(argv, stream=True)
    print("OK: tcpdump finished.")
    return 0


