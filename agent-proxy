def ip_cmd_show(args: argparse.Namespace) -> int:
    obj = args.obj
    argv = [ip_path()]
    if getattr(args, "stats", False):
        argv.append("-s")
    if getattr(args, "brief", False):
        argv.append("-brief")
    argv += [obj, "show"]
    dev = getattr(args, "dev", None)
    if dev:
        argv += ["dev", validate_iface(dev)]
    proc = run_command(argv)
    sys.stdout.write(proc.stdout)
    return 0


