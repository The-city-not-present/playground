#!/usr/bin/env python3
"""nmcli-proxy - a narrow, auditable wrapper around NetworkManager's ``nmcli``.

Purpose
-------
Allow an *unprivileged* (agent) user to perform a small, fixed set of network
management tasks without handing out full root/sudo access:

  * assign a static IPv4 address to a connection
  * switch a connection back to DHCP
  * force a DHCP lease renewal ("re-retrieve the IP")
  * restart an interface / connection
  * reapply the current profile to a device
  * (read-only) list connections and show device status

How it works / privilege model
------------------------------
This script **never runs as root itself**.  For privileged operations it builds
a *fixed, validated* command line and executes it via ``sudo -n`` using an
absolute path and a list of arguments (never a shell string), so there is no
shell-injection surface.  The accompanying ``sudoers.d`` rule grants the
calling user passwordless sudo access *only* to the nmcli subcommands below:

    <user> ALL=(root) NOPASSWD: <nmcli> connection modify *
    <user> ALL=(root) NOPASSWD: <nmcli> connection up *
    <user> ALL=(root) NOPASSWD: <nmcli> connection down *
    <user> ALL=(root) NOPASSWD: <nmcli> device disconnect *
    <user> ALL=(root) NOPASSWD: <nmcli> device connect *
    <user> ALL=(root) NOPASSWD: <nmcli> device reapply *

No other root operation is permitted.  Run ``nmcli-proxy sudoers`` to print the
exact rule for your environment and ``nmcli-proxy doctor`` to verify the setup.

Error reporting philosophy
--------------------------
Fail early and loudly.  Every expected failure reports: the exact command line,
the exit code, and the original stdout/stderr (the *original* error is never
swallowed).  Unexpected exceptions always print the full Python traceback.
Use ``--traceback`` to get the traceback for expected failures as well.
"""

from __future__ import annotations

import argparse
import ipaddress
import os
import pwd
import re
import shlex
import shutil
import subprocess
import sys
import textwrap
import traceback
from typing import List, Optional, Sequence

__version__ = "1.0.0"

PROG = "nmcli-proxy"
NMCLLI_FALLBACK = "/usr/bin/nmcli"
SUDO_FALLBACK = "/usr/bin/sudo"

# Linux interface names: 1-15 chars, alnum plus a small safe set, first char alnum.
IFACE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,14}$")

DRY_RUN: bool = False


class NetworkHelperError(Exception):
    """A loud, structured error that preserves the original failure details.

    ``message`` is a human-readable one-liner; ``command`` is the argv list
    that failed; ``returncode``/``stdout``/``stderr`` carry the original
    subprocess output so nothing about the underlying error is lost.
    """

    def __init__(
        self,
        message: str,
        *,
        command: Optional[Sequence[str]] = None,
        returncode: Optional[int] = None,
        stdout: Optional[str] = None,
        stderr: Optional[str] = None,
    ) -> None:
        super().__init__(message)
        self.message = message
        self.command = list(command) if command else None
        self.returncode = returncode
        self.stdout = stdout
        self.stderr = stderr

    def __str__(self) -> str:
        lines = [f"ERROR: {self.message}"]
        if self.command:
            lines.append(f"  command:   {format_argv(self.command)}")
        if self.returncode is not None:
            lines.append(f"  exit code: {self.returncode}")
        if self.stdout and self.stdout.strip():
            lines.append("  stdout:\n" + textwrap.indent(self.stdout.strip(), "    "))
        if self.stderr and self.stderr.strip():
            lines.append("  stderr:\n" + textwrap.indent(self.stderr.strip(), "    "))
        return "\n".join(lines)


def format_argv(argv: Sequence[str]) -> str:
    return " ".join(shlex.quote(a) for a in argv)


def current_user() -> str:
    """Return the current login name, falling back to the passwd database."""
    try:
        return os.getlogin()
    except OSError:
        pass
    return pwd.getpwuid(os.getuid()).pw_name


def nmcli_path() -> str:
    """Absolute, symlink-resolved path to nmcli (consistent for sudoers)."""
    found = shutil.which("nmcli")
    if not found:
        return NMCLLI_FALLBACK
    return os.path.realpath(found)


def sudo_path() -> str:
    return shutil.which("sudo") or SUDO_FALLBACK


def run_command(argv: Sequence[str]) -> subprocess.CompletedProcess:
    """Run a command, capturing output; raise a loud error on any failure.

    ``--dry-run`` only skips *privileged* commands (those that start with
    ``sudo``).  Read-only nmcli queries still run so that ``--device`` can be
    resolved to a connection name.
    """
    argv = list(argv)
    is_privileged = bool(argv) and os.path.basename(argv[0]) == "sudo"
    if DRY_RUN and is_privileged:
        print(f"[dry-run] would run: {format_argv(argv)}")
        return subprocess.CompletedProcess(argv, 0, stdout="", stderr="")

    try:
        proc = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    except FileNotFoundError as exc:
        raise NetworkHelperError(
            f"Executable not found: {argv[0]!r}. Is it installed?", command=argv
        ) from exc
    except OSError as exc:
        raise NetworkHelperError(f"Failed to start {argv[0]!r}: {exc}", command=argv) from exc

    if proc.returncode != 0:
        raise NetworkHelperError(
            f"Command exited with status {proc.returncode}.",
            command=argv,
            returncode=proc.returncode,
            stdout=proc.stdout,
            stderr=proc.stderr,
        )
    return proc


# ---------------------------------------------------------------------------
# Input validation (fail early, before any privileged action is attempted)
# ---------------------------------------------------------------------------

def validate_connection(name: str) -> str:
    name = (name or "").strip()
    if not name:
        raise NetworkHelperError("Connection name must not be empty.")
    if len(name) > 255:
        raise NetworkHelperError(f"Connection name too long ({len(name)} > 255).")
    if name.startswith("-"):
        raise NetworkHelperError("Connection name must not start with '-'.")
    if any(ord(c) < 32 or ord(c) == 127 for c in name):
        raise NetworkHelperError("Connection name contains control characters.")
    return name


def validate_iface(name: str) -> str:
    name = (name or "").strip()
    if not IFACE_RE.match(name):
        raise NetworkHelperError(
            f"Invalid interface name {name!r}: expected 1-15 chars, e.g. 'eth0', "
            "'wlp2s0', 'enp3s0'."
        )
    return name


def validate_cidr(value: str) -> str:
    try:
        iface = ipaddress.ip_interface(value.strip())
    except ValueError as exc:
        raise NetworkHelperError(
            f"Invalid IPv4 address/prefix {value!r}: expected CIDR notation like "
            "'192.168.1.10/24'."
        ) from exc
    if iface.version != 4:
        raise NetworkHelperError(f"Only IPv4 is supported, got {value!r}.")
    return str(iface)


def validate_ip(value: str, what: str) -> str:
    try:
        addr = ipaddress.ip_address(value.strip())
    except ValueError as exc:
        raise NetworkHelperError(f"Invalid {what} address {value!r}.") from exc
    if addr.version != 4:
        raise NetworkHelperError(f"Only IPv4 is supported for {what}, got {value!r}.")
    return str(addr)


def validate_dns(values: Sequence[str]) -> List[str]:
    result: List[str] = []
    for raw in values:
        for part in (raw or "").split(","):
            part = part.strip()
            if part:
                result.append(validate_ip(part, "DNS server"))
    return result


# ---------------------------------------------------------------------------
# nmcli helpers (read-only discovery)
# ---------------------------------------------------------------------------

def _active_connection_lines() -> List[str]:
    proc = run_command(
        [nmcli_path(), "-t", "-f", "DEVICE,NAME,UUID,STATE", "connection", "show", "--active"]
    )
    return proc.stdout.splitlines()


def connection_for_device(dev: str) -> str:
    """Resolve the active connection profile name for an interface."""
    for line in _active_connection_lines():
        parts = line.split(":", 3)
        if len(parts) == 4 and parts[0] == dev and parts[3].strip() == "activated":
            return parts[1]
    raise NetworkHelperError(
        f"No active connection found for device {dev!r}. "
        f"Run '{PROG} list --active' to see active connections."
    )


def connection_is_active(conn: str) -> bool:
    """True if the connection (matched by name *or* UUID) is currently active."""
    for line in _active_connection_lines():
        parts = line.split(":", 3)
        if len(parts) == 4 and (parts[1] == conn or parts[2] == conn):
            return parts[3].strip() == "activated"
    return False


def device_is_connected(dev: str) -> bool:
    proc = run_command([nmcli_path(), "-t", "-f", "DEVICE,STATE", "device", "status"])
    for line in proc.stdout.splitlines():
        parts = line.split(":", 1)
        if len(parts) == 2 and parts[0] == dev:
            return parts[1].strip() in ("connected", "activated")
    return False


def resolve_connection(args: argparse.Namespace) -> str:
    """Return a validated connection identifier from --connection/--device."""
    if getattr(args, "connection", None):
        return validate_connection(args.connection)
    if getattr(args, "device", None):
        return connection_for_device(validate_iface(args.device))
    raise NetworkHelperError("Provide either --connection <id> or --device <iface>.")


# ---------------------------------------------------------------------------
# Privileged command builders / runners
# ---------------------------------------------------------------------------

def _nmcli_sudo(*argv: str) -> None:
    run_command([sudo_path(), "-n", nmcli_path(), *argv])


def _activate(conn: str, wait: int) -> None:
    _nmcli_sudo("connection", "up", conn, "--wait", str(wait))


def _down_then_up(conn: str, wait: int) -> None:
    if connection_is_active(conn):
        _nmcli_sudo("connection", "down", conn)
    _activate(conn, wait)

# ---------------------------------------------------------------------------
# Subcommand implementations
# ---------------------------------------------------------------------------

def cmd_doctor(args: argparse.Namespace) -> int:
    ok = True
    nmcli = nmcli_path()
    sudo = sudo_path()
    print(f"{PROG} version: {__version__}")
    print(f"nmcli: {nmcli} ({'on PATH' if shutil.which('nmcli') else 'NOT on PATH, using fallback'})")
    if not os.path.exists(nmcli):
        print("  WARN: nmcli not found - is NetworkManager installed?")
        ok = False
    print(f"sudo:  {sudo} ({'on PATH' if shutil.which('sudo') else 'NOT on PATH'})")
    if not os.path.exists(sudo):
        print("  WARN: sudo not found.")
        ok = False

    user = current_user()
    print(f"user:  {user}")

    listing = ""
    returncode = None
    try:
        proc = subprocess.run([sudo, "-n", "-l"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        listing = (proc.stdout or "") + (proc.stderr or "")
        returncode = proc.returncode
    except OSError as exc:
        print(f"  WARN: could not run 'sudo -n -l': {exc}")
        ok = False

    if returncode == 0:
        if "nmcli" in listing:
            print("  OK: narrow sudoers rules for nmcli appear to be present.")
        elif "(ALL" in listing or "ALL : ALL" in listing or "(root) ALL" in listing:
            print("  NOTE: user already has broad sudo privileges; a narrow nmcli rule is not required.")
        else:
            print(f"  WARN: no nmcli rule found in sudo privileges. Run '{PROG} sudoers' and install it.")
            ok = False
    else:
        print("  WARN: 'sudo -n -l' failed - the user may have no sudo privileges at all.")
        ok = False

    print("doctor result:", "OK" if ok else "ISSUES FOUND")
    return 0 if ok else 1


def cmd_sudoers(args: argparse.Namespace) -> int:
    user = args.user or current_user()
    nmcli = nmcli_path()
    print(
        textwrap.dedent(
            f"""\
            # NetworkManager proxy for agent tasks - generated by {PROG}.
            # Grants '{user}' passwordless sudo access to a NARROW subset of nmcli:
            # modify/activate/deactivate connection profiles and connect/disconnect
            # devices. No other root operations are permitted.
            #
            # Install with:
            #   sudo sh -c '{PROG} sudoers --user {user} > /etc/sudoers.d/{PROG} && chmod 0440 /etc/sudoers.d/{PROG} && visudo -c -f /etc/sudoers.d/{PROG}'
            #
            {user} ALL=(root) NOPASSWD: {nmcli} connection modify *
            {user} ALL=(root) NOPASSWD: {nmcli} connection up *
            {user} ALL=(root) NOPASSWD: {nmcli} connection down *
            {user} ALL=(root) NOPASSWD: {nmcli} device disconnect *
            {user} ALL=(root) NOPASSWD: {nmcli} device connect *
            {user} ALL=(root) NOPASSWD: {nmcli} device reapply *
            """
        )
    )
    return 0


def cmd_list(args: argparse.Namespace) -> int:
    argv = [nmcli_path(), "-t", "-f", "NAME,UUID,DEVICE,TYPE,STATE", "connection", "show"]
    if args.active:
        argv.append("--active")
    proc = run_command(argv)
    sys.stdout.write(proc.stdout)
    return 0


def cmd_devices(args: argparse.Namespace) -> int:
    proc = run_command([nmcli_path(), "-t", "device", "status"])
    sys.stdout.write(proc.stdout)
    return 0


def cmd_show(args: argparse.Namespace) -> int:
    if args.connection:
        argv = [nmcli_path(), "connection", "show", validate_connection(args.connection)]
    else:
        argv = [nmcli_path(), "device", "show", validate_iface(args.device)]
    proc = run_command(argv)
    sys.stdout.write(proc.stdout)
    return 0


def cmd_set_static(args: argparse.Namespace) -> int:
    conn = resolve_connection(args)
    address = validate_cidr(args.address)
    gateway = validate_ip(args.gateway, "gateway") if args.gateway else ""
    dns = validate_dns(args.dns)
    dns_arg = " ".join(dns) if dns else ""

    _nmcli_sudo(
        "connection", "modify", conn,
        "ipv4.method", "manual",
        "ipv4.addresses", address,
        "ipv4.gateway", gateway,
        "ipv4.dns", dns_arg,
    )
    _activate(conn, args.wait)

    summary = f"static {address}"
    summary += f" gateway {gateway}" if gateway else " (no gateway)"
    summary += f" dns {', '.join(dns)}" if dns else " (no dns)"
    print(f"OK: set {conn!r} to {summary} and activated it.")
    return 0


def cmd_set_dhcp(args: argparse.Namespace) -> int:
    conn = resolve_connection(args)
    _nmcli_sudo(
        "connection", "modify", conn,
        "ipv4.method", "auto",
        "ipv4.addresses", "",
        "ipv4.gateway", "",
        "ipv4.dns", "",
    )
    _activate(conn, args.wait)
    print(f"OK: set {conn!r} to DHCP (ipv4.method=auto) and activated it.")
    return 0


def cmd_renew(args: argparse.Namespace) -> int:
    conn = resolve_connection(args)
    _down_then_up(conn, args.wait)
    print(f"OK: renewed DHCP on {conn!r} (down + up).")
    return 0


def cmd_restart(args: argparse.Namespace) -> int:
    if args.device:
        dev = validate_iface(args.device)
        if device_is_connected(dev):
            _nmcli_sudo("device", "disconnect", dev)
        _nmcli_sudo("device", "connect", dev)
        print(f"OK: restarted interface {dev!r} (disconnect + connect).")
    else:
        conn = validate_connection(args.connection)
        _down_then_up(conn, args.wait)
        print(f"OK: restarted connection {conn!r} (down + up).")
    return 0


def cmd_reapply(args: argparse.Namespace) -> int:
    dev = validate_iface(args.device)
    _nmcli_sudo("device", "reapply", dev)
    print(f"OK: reapplied configuration on device {dev!r}.")
    return 0

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

def add_target_args(parser: argparse.ArgumentParser, required: bool) -> None:
    group = parser.add_mutually_exclusive_group(required=required)
    group.add_argument("--connection", help="Connection name or UUID.")
    group.add_argument(
        "--device",
        help="Interface name, e.g. eth0 (the active connection will be resolved automatically).",
    )


def add_wait_arg(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "--wait",
        type=int,
        default=15,
        metavar="SECONDS",
        help="Seconds to wait for activation (default 15; 0 = do not wait).",
    )


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=PROG,
        description="Narrow, auditable wrapper around NetworkManager's nmcli for unprivileged agents.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Examples:\n"
            f"  {PROG} list\n"
            f"  {PROG} devices\n"
            f"  {PROG} show --device eth0\n"
            f"  {PROG} set-static --connection 'Wired connection 1' --address 192.168.1.10/24 --gateway 192.168.1.1 --dns 8.8.8.8\n"
            f"  {PROG} set-dhcp --device eth0\n"
            f"  {PROG} renew --device eth0\n"
            f"  {PROG} restart --connection 'Wired connection 1'\n"
            f"  {PROG} sudoers      # print the sudoers rules to install\n"
            f"  {PROG} doctor       # verify the setup\n"
        ),
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {__version__}")
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Print the privileged commands that would be run, without executing them.",
    )
    parser.add_argument(
        "--traceback",
        action="store_true",
        help="Also print the full Python traceback for expected (handled) failures.",
    )

    sub = parser.add_subparsers(dest="command", required=True, metavar="COMMAND")

    p = sub.add_parser("doctor", help="Check environment and sudoers setup.")
    p.set_defaults(func=cmd_doctor)

    p = sub.add_parser("sudoers", help="Print the sudoers rules needed for the current user.")
    p.add_argument("--user", default=None, help="User to grant privileges to (default: current user).")
    p.set_defaults(func=cmd_sudoers)

    p = sub.add_parser("list", aliases=["connections"], help="List connection profiles.")
    p.add_argument("--active", action="store_true", help="Only show active connections.")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("devices", aliases=["status"], help="Show device status.")
    p.set_defaults(func=cmd_devices)

    p = sub.add_parser("show", help="Show details for a connection or device.")
    add_target_args(p, required=True)
    p.set_defaults(func=cmd_show)

    p = sub.add_parser("set-static", help="Set a static IPv4 address on a connection and activate it.")
    add_target_args(p, required=True)
    p.add_argument("--address", required=True, metavar="IP/PREFIX", help="Static IPv4 in CIDR notation, e.g. 192.168.1.10/24.")
    p.add_argument("--gateway", default=None, metavar="IP", help="Gateway IPv4 (cleared if omitted).")
    p.add_argument("--dns", action="append", default=[], metavar="IP", help="DNS server IP (repeatable or comma-separated).")
    add_wait_arg(p)
    p.set_defaults(func=cmd_set_static)

    p = sub.add_parser("set-dhcp", help="Switch a connection back to DHCP and activate it.")
    add_target_args(p, required=True)
    add_wait_arg(p)
    p.set_defaults(func=cmd_set_dhcp)

    p = sub.add_parser("renew", help="Force a DHCP lease renewal (deactivate + activate the connection).")
    add_target_args(p, required=True)
    add_wait_arg(p)
    p.set_defaults(func=cmd_renew)

    p = sub.add_parser("restart", help="Restart an interface or connection (deactivate + activate).")
    add_target_args(p, required=True)
    add_wait_arg(p)
    p.set_defaults(func=cmd_restart)

    p = sub.add_parser("reapply", help="Reapply the active connection profile to a device.")
    p.add_argument("--device", required=True, help="Interface name.")
    p.set_defaults(func=cmd_reapply)

    return parser


def main(argv: Optional[Sequence[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    global DRY_RUN
    DRY_RUN = args.dry_run

    try:
        return int(args.func(args))
    except NetworkHelperError as exc:
        print(exc, file=sys.stderr)
        if exc.command and os.path.basename(exc.command[0]) == "sudo":
            print(
                "  hint: sudo refused to run nmcli non-interactively. Install the sudoers rule:\n"
                f"        sudo sh -c '{PROG} sudoers > /etc/sudoers.d/{PROG} && chmod 0440 /etc/sudoers.d/{PROG} && visudo -c -f /etc/sudoers.d/{PROG}'\n"
                f"        then verify with: {PROG} doctor",
                file=sys.stderr,
            )
        if args.traceback:
            traceback.print_exc()
        return 1
    except KeyboardInterrupt:
        print("\nERROR: interrupted by user.", file=sys.stderr)
        return 130
    except Exception as exc:  # noqa: BLE001 - report *everything* loudly
        print(f"UNEXPECTED ERROR: {exc}", file=sys.stderr)
        traceback.print_exc()
        return 2


if __name__ == "__main__":
    sys.exit(main())
